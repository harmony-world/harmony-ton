# === Required ===
DATABASE_URL="postgresql://donato:donato@localhost:5432/donato"
BOT_TOKEN="your-telegram-bot-token"
PORT=3000
NODE_ENV=development
# HOST=127.0.0.1
# LOG_LEVEL=info
# Set to "true" when behind a trusted reverse proxy (nginx, Cloudflare)
TRUST_PROXY=true

# === TON / Deploy ===
TON_NETWORK=testnet
HARMONY_MASTER_ADDR=
HARMONY_MASTER_ADDRS=
HARMONY_CAMPAIGN_ADDRS=
# Deployer wallet mnemonic (testnet/dev only; forbidden when TON_NETWORK=mainnet)
DEPLOYER_MNEMONIC=
# Mainnet must use file with 0600 permissions.
# DEPLOYER_MNEMONIC_FILE=./secrets/deployer.key
DEPLOYER_MIN_BALANCE_GRAM=2
DEPLOYER_DEPLOY_VALUE_GRAM=0.15
# DEPLOYER_DEPLOY_FEE_GRAM=0.05
# USDT jetton master address on TON (required for USDT donations)
HARMONY_USDT_MASTER_ADDR=
# Platform wallet for tips destination (required; mainnet: owner's wallet)
HARMONY_PLATFORM_WALLET=
# TON_WALLET_NETWORK_GLOBAL_ID=-3

# === Indexer ===
# INDEXER_POLL_MS=5000
# STREAMING_API_ENABLED=true
# STREAMING_API_KEY=
# TON_CENTER_API_KEY=
# Optional override; defaults to the public toncenter v2 JSON-RPC for TON_NETWORK.
# TON_CENTER_V2_ENDPOINT=

# === KYC ===
# Provider options: didit | sumsub | mock
# Production default should be didit after Didit credentials are configured.
KYC_PROVIDER=didit

# Highest KYC level exposed to end users. MVP ceiling is 2 (also the default).
# Levels 3-5 stay fully implemented: /kyc/status hides them and verification requests
# for them are rejected with 403 KYC_LEVEL_NOT_AVAILABLE.
# To bring them back: KYC_MAX_VISIBLE_LEVEL=5 here + VITE_KYC_MAX_VISIBLE_LEVEL=5 in the frontend.
KYC_MAX_VISIBLE_LEVEL=2

# Didit credentials are server-side only. Never expose them to frontend.
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_WORKFLOW_ID=
DIDIT_KYC2_WORKFLOW_ID=
DIDIT_KYC3_WORKFLOW_ID=
DIDIT_KYC4_WORKFLOW_ID=
# Restrict Didit to provider-supported levels. Free tier should be DIDIT_ENABLED_KYC_LEVELS=2.
# Paid/extended provider setup can use 2,3,4 after workflow + credits verification.
# DIDIT_ENABLED_KYC_LEVELS=2,3,4
# Sandbox applications only: deterministic test outcome, for example approve.
# Leave empty for live applications; Didit rejects sandbox_scenario on live keys.
# DIDIT_SANDBOX_SCENARIO=approve
# Didit KYC4 policy: ID/liveness/address/AML. Sumsub may use a stricter provider-step policy.
# KYC4_REQUIRED_SUMSUB_STEPS=IDENTITY,SELFIE,PROOF_OF_RESIDENCE,AML

# Legacy Sumsub rollback path.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
# SUMSUB_WEBHOOK_SECRET=
# SUMSUB_LEVEL_NAME=basic-kyc
# SUMSUB_BASIC_LEVEL_NAME=basic-kyc
# SUMSUB_EXTENDED_LEVEL_NAME=extended-kyc
# SUMSUB_FULL_LEVEL_NAME=full-kyc

# Emergency mock rollback path. Keep false by default.
# To enable in production/testnet: KYC_PROVIDER=mock + both flags true, then restart backend.
# KYC_MOCK_ENABLED=false
# KYC_MOCK_ALLOW_PRODUCTION=false

# Required for the KYC webhook: HMAC key for the document fingerprint (>= 32 chars).
# The webhook refuses to run without it instead of falling back to a plain hash.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOC_HASH_KEY=

# === Owner ===
OWNER_TG_ID=

# === Moderation ===
MODERATION_BOT_TOKEN=
MODERATOR_TG_IDS=
HARMONY_AUTO_MODERATION_ENABLED=true

# === CORS ===
# Comma-separated allowed origins. Without this, production rejects browser requests.
CORS_ORIGIN=https://app.example.com

# === Auth ===
AUTH_MAX_AGE_SECONDS=3600
AUTH_CACHE_TTL_MS=300000
AUTH_FAILURE_RATE_LIMIT_MAX=20
AUTH_FAILURE_RATE_LIMIT_WINDOW_MS=60000
# Service API keys for programmatic access (Authorization: Bearer <key>).
# Format: label:key:userId,... — key is 64 hex chars, userId is the User UUID (not tgUserId).
# Empty (default) disables Bearer auth entirely. Generate a key on the server:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# HARMONY_SERVICE_API_KEYS=

# === Wallet proof ===
# WALLET_PROOF_DOMAIN=app.example.com
# WALLET_PROOF_MAX_AGE_SECONDS=600
# WALLET_PROOF_CHALLENGE_TTL_MS=300000

# === Rate limits ===
RATE_LIMIT_UPLOADS_MAX=20
RATE_LIMIT_UPLOADS_WINDOW_MS=60000
RATE_LIMIT_UPLOADS_DELETE_MAX=30
RATE_LIMIT_UPLOADS_DELETE_WINDOW_MS=60000
RATE_LIMIT_SUPPORT_MAX=5
RATE_LIMIT_SUPPORT_WINDOW_MS=600000
RATE_LIMIT_KYC_TOKEN_MAX=5
RATE_LIMIT_KYC_TOKEN_WINDOW_MS=600000
RATE_LIMIT_DONATION_INTENTS_MAX=30
RATE_LIMIT_DONATION_INTENTS_WINDOW_MS=60000
RATE_LIMIT_CHANNEL_INFO_MAX=30
RATE_LIMIT_CHANNEL_INFO_WINDOW_MS=60000
# RATE_LIMIT_CAMPAIGN_CREATE_MAX=10
# RATE_LIMIT_CAMPAIGN_CREATE_WINDOW_MS=60000
# RATE_LIMIT_WALLET_BIND_MAX=5
# RATE_LIMIT_WALLET_BIND_WINDOW_MS=60000
# RATE_LIMIT_WEBHOOK_MAX=60
# RATE_LIMIT_WEBHOOK_WINDOW_MS=60000

# === Admin Panel ===
# ADMIN_AUTH_MAX_AGE_SECONDS=28800

# === Ops ===
OPS_ALERT_TG_USER_ID=
# OPS_TG_USER_ID=
# OPS_ALERT_RATE_LIMIT_MS=60000

# === Uploads ===
# UPLOADS_DIR=./uploads
# UPLOAD_CLEANUP_INTERVAL_MS=3600000
# UPLOAD_ORPHAN_TTL_MS=86400000

# === Emoji / Sticker ===
# STICKER_SET_OWNER_ID=

# === External APIs ===
COINGECKO_API_URL=https://api.coingecko.com/api/v3
LARA_ACCESS_KEY_ID=
LARA_ACCESS_KEY_SECRET=
LARA_TRANSLATION_NO_TRACE=true
# Optional override; defaults to testnet/mainnet TonAPI by TON_NETWORK.
TON_API_BASE_URL=

# === Telegram ===
# Bot username without @, used in share links.
# BOT_USERNAME=
# Private chat the bot uploads campaign photos to, so Telegram can cache them (0 = off).
# MEDIA_STORAGE_CHAT_ID=
# Donation widget in channel posts.
# DONATION_WIDGET_ENABLED=false

# === Frontend ===
WEB_APP_URL=https://app.example.com
# MINI_APP_URL=https://app.example.com
