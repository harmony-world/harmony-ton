/// Simulate incoming TEP-74 transfer_notification with Donate tipBps in forward_payload
fun HarmonyCampaign.sendTransferNotificationWithTip(
    self,
    from: address,
    queryId: uint64,
    amount: coins,
    sender: address,
    tipBps: uint32,
    config: SendParams = {},
): SendResultList {
    val tipPayload = beginCell()
        .storeUint(0x10000001, 32)
        .storeUint(tipBps, 32)
        .endCell();
    val genericMsg = createMessage({
        bounce: config.bounce,
        value: config.value,
        dest: self.address,
        body: TransferNotification {
            queryId,
            amount,
            sender,
            forwardPayload: beginCell().storeUint(1, 1).storeRef(tipPayload).endCell().beginParse(),
        },
    });
    return net.send(from, genericMsg);
}

